POSTGRES_DB=conekta
POSTGRES_USER=conekta
POSTGRES_PASSWORD=conekta_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://conekta:conekta_dev_password@localhost:5433/conekta?schema=public
API_PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_of_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:3000
WEB_PORT=8080
WEB_URL=http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:3000

# Correo real en desarrollo mediante Mailpit (bandeja en http://localhost:8025).
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ConekTa <no-reply@conekta.local>

# Almacenamiento S3-compatible. MinIO se incluye para desarrollo.
STORAGE_ENABLED=true
S3_REGION=us-east-1
S3_BUCKET=conekta-files
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=conekta_minio
S3_SECRET_ACCESS_KEY=change_this_minio_password
S3_PUBLIC_URL=http://localhost:9000/conekta-files

# Web Push nativo. Genera claves con: npx web-push generate-vapid-keys
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@tu-dominio.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# TURN es recomendado en producción para WebRTC detrás de NAT/firewalls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Seed administrativo (npm run db:seed). No uses credenciales de ejemplo en producción.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed académico opcional (npm run db:seed:demo). Se bloquea si NODE_ENV=production.
DEMO_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=admin.demo@conekta.local
DEMO_COMPANY_EMAIL=empresa.demo@conekta.local
DEMO_CANDIDATE_EMAILS=laura.demo@conekta.local,mateo.demo@conekta.local,sofia.demo@conekta.local
DEMO_PASSWORD=
