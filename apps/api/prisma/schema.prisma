generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum SkillType {
  TECHNICAL
  SOFT
}

enum EducationStatus {
  ESTUDIANDO
  GRADUADO
}

enum WorkSchedule {
  FULL_TIME
  PART_TIME
  FLEXIBLE
}

enum WorkModality {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OpportunityType {
  FIRST_JOB
  INTERNSHIP
  APPRENTICESHIP
  TRAINEE
}

enum VacancySkillPriority {
  REQUIRED
  DESIRED
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  SELECTED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  HIRED
  CANCELLED
  REJECTED
  WITHDRAWN
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FilePurpose {
  PROFILE_PHOTO
  COMPANY_LOGO
  PROJECT_ATTACHMENT
  CHAT_ATTACHMENT
  COMPANY_VERIFICATION_DOCUMENT
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum NotificationType {
  ACCOUNT
  APPLICATION
  MESSAGE
  INTERVIEW
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ExperienceOpportunityStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExperienceApplicationStatus {
  APPLIED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum ExperienceCertificateStatus {
  ACTIVE
  REVOKED
}

enum ContributionValidationStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  emailVerified Boolean @default(false)
  refreshTokenHash String?
  termsAcceptedAt DateTime?
  termsVersion String?
  privacyAcceptedAt DateTime?
  privacyVersion String?
  majorityAgeConfirmedAt DateTime?
  marketingConsent Boolean @default(false)
  deletionRequestedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidateProfile CandidateProfile?
  companyProfile   CompanyProfile?
  accountTokens AccountToken[]
  files FileAsset[]
  notifications Notification[]
  sentMessages Message[]
  scheduledInterviews Interview[] @relation("InterviewScheduler")
  pushSubscriptions PushSubscription[]
  deletionRequests AccountDeletionRequest[] @relation("DeletionRequestOwner")
  reviewedDeletionRequests AccountDeletionRequest[] @relation("DeletionRequestReviewer")

  @@map("users")
}

model CandidateProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  headline  String?
  bio       String?
  city      String?
  region    String?
  country   String?
  phone     String?
  photoUrl  String?
  linkedinUrl String?
  githubUrl String?
  portfolioUrl String?
  availableNow Boolean @default(false)
  visibleToCompanies Boolean @default(true)
  workSchedule WorkSchedule?
  modalities WorkModality[] @default([])
  professionalInterests String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    CandidateSkill[]
  projects  Project[]
  certifications Certification[]
  applications Application[]
  educations Education[]
  experienceApplications ExperienceApplication[]
  verifiedExperiences VerifiedExperience[]
  skillEvidence SkillEvidence[]
  projectContributions ProjectContribution[]
  talentPassport TalentPassport?

  @@map("candidate_profiles")
}

model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String?
  description String?
  website     String?
  city        String?
  logoUrl     String?
  nit         String?  @unique
  sector      String?
  size        CompanySize?
  country     String?
  address     String?
  linkedinUrl String?
  contactEmail String?
  phone       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationRequestedAt DateTime?
  verificationDocumentUrl String?
  verificationDocumentName String?
  verificationReviewedAt DateTime?
  verificationReviewedById String?
  verificationReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies   Vacancy[]
  applications Application[]
  experienceOpportunities ExperienceOpportunity[]
  opportunityIndex CompanyOpportunityIndex?

  @@map("company_profiles")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  category    String
  type        SkillType
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  candidates  CandidateSkill[]
  vacancies   VacancySkill[]
  experienceSkills ExperienceSkill[]
  verifiedSkills VerifiedSkill[]
  evidence SkillEvidence[]

  @@map("skills")
  @@index([active, type, category])
}

model CandidateSkill {
  candidateId String
  skillId     String
  level       SkillLevel @default(BASIC)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@map("candidate_skills")
}

model Vacancy {
  id               String        @id @default(uuid())
  companyId        String
  title            String
  description      String
  location         String?
  city             String
  remote           Boolean       @default(false)
  responsibilities String[]      @default([])
  requirements     String[]      @default([])
  modality         WorkModality  @default(PRESENCIAL)
  opportunityType  OpportunityType @default(FIRST_JOB)
  contractType     String
  department       String?
  workSchedule     WorkSchedule @default(FULL_TIME)
  weeklyHours      Int?
  benefits         String[] @default([])
  requiresUniversityAgreement Boolean @default(false)
  salaryMin        Int?
  salaryMax        Int?
  currency         String        @default("COP")
  showSalary       Boolean       @default(false)
  deadline         DateTime?
  relatedCareers   String[]      @default([])
  maxExperienceMonths Int        @default(0)
  experienceRequired Boolean     @default(false)
  adminHidden      Boolean       @default(false)
  status           VacancyStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills           VacancySkill[]
  applications     Application[]

  @@index([companyId, status])
  @@index([status, adminHidden, publishedAt])
  @@map("vacancies")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String
  entityId    String
  data        Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model VacancySkill {
  vacancyId String
  skillId   String
  required  Boolean @default(true)
  priority  VacancySkillPriority @default(REQUIRED)
  weight    Int @default(3)
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([vacancyId, skillId])
  @@map("vacancy_skills")
}

model Project {
  id          String   @id @default(uuid())
  candidateId String
  title       String
  description String
  role        String
  technologies String[] @default([])
  url         String?
  githubUrl   String?
  projectDate DateTime
  projectType String
  universityProject Boolean @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contributions ProjectContribution[]

  @@index([candidateId])
  @@map("projects")
}

model Certification {
  id             String   @id @default(uuid())
  candidateId    String
  name           String
  issuingEntity  String
  credentialUrl  String?
  issuedAt       DateTime
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("certifications")
}

model Education {
  id                     String          @id @default(uuid())
  candidateId            String
  institution            String
  program                String
  academicLevel          String
  semester               Int?
  status                 EducationStatus
  expectedGraduationDate DateTime?
  graduationDate         DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  candidate              CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("educations")
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  vacancyId   String
  companyId   String
  compatibilityScore Int
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?
  offerSalary Int?
  offerCurrency String @default("COP")
  offeredStartDate DateTime?
  offerNotes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  company     CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statusHistory ApplicationStatusHistory[]
  conversation Conversation?
  interviews Interview[]

  @@unique([candidateId, vacancyId])
  @@index([vacancyId, status])
  @@index([companyId, status])
  @@index([candidateId, createdAt])
  @@index([vacancyId, compatibilityScore])
  @@index([companyId, createdAt])
  @@map("applications")
}

model AccountDeletionRequest {
  id String @id @default(uuid())
  userId String
  status DeletionRequestStatus @default(PENDING)
  reason String?
  adminNote String?
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  completedAt DateTime?
  user User @relation("DeletionRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DeletionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@map("account_deletion_requests")
}

model AccountToken {
  id        String           @id @default(uuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("account_tokens")
}

model FileAsset {
  id          String      @id @default(uuid())
  ownerId     String
  purpose     FilePurpose
  objectKey   String      @unique
  originalName String
  mimeType    String
  sizeBytes   Int
  publicUrl   String
  createdAt   DateTime    @default(now())
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, purpose, createdAt])
  @@map("file_assets")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("push_subscriptions")
}

model Conversation {
  id            String      @id @default(uuid())
  applicationId String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  scheduledById String
  startsAt      DateTime
  endsAt        DateTime
  timezone      String
  location      String?
  meetingUrl    String?
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledBy   User            @relation("InterviewScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)

  @@index([applicationId, startsAt])
  @@index([scheduledById, startsAt])
  @@map("interviews")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  changedAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@map("application_status_history")
}

model ExperienceOpportunity {
  id                  String                      @id @default(uuid())
  companyId           String
  title               String
  description         String
  objective           String
  activities          String[]                    @default([])
  professionalArea    String
  modality            WorkModality
  city                String?
  estimatedDurationWeeks Int
  startsAt            DateTime?
  deadline            DateTime?
  participantLimit    Int                         @default(1)
  expectedDeliverables String[]                   @default([])
  status              ExperienceOpportunityStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  company             CompanyProfile              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills              ExperienceSkill[]
  applications        ExperienceApplication[]

  @@index([companyId, status])
  @@index([status, publishedAt])
  @@map("experience_opportunities")
}

model ExperienceSkill {
  experienceId String
  skillId      String
  priority     VacancySkillPriority @default(REQUIRED)
  weight       Int                  @default(3)
  experience  ExperienceOpportunity @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill       Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
  @@map("experience_skills")
}

model ExperienceApplication {
  id                 String                      @id @default(uuid())
  experienceId       String
  candidateId        String
  compatibilityScore Int
  status             ExperienceApplicationStatus @default(APPLIED)
  motivation         String?
  acceptedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  experience         ExperienceOpportunity       @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  candidate          CandidateProfile            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submission         ExperienceSubmission?
  evaluation         ExperienceEvaluation?
  verifiedExperience VerifiedExperience?

  @@unique([experienceId, candidateId])
  @@index([candidateId, status])
  @@index([experienceId, status])
  @@map("experience_applications")
}

model ExperienceSubmission {
  id             String                @id @default(uuid())
  applicationId  String                @unique
  workDescription String
  projectUrl     String
  githubUrl      String?
  additionalLinks String[]             @default([])
  comments       String?
  submittedAt    DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  application    ExperienceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("experience_submissions")
}

model ExperienceEvaluation {
  id               String                @id @default(uuid())
  applicationId    String                @unique
  compliance       Int
  quality           Int
  responsibility   Int
  communication    Int
  teamwork          Int
  technicalSkills  Int
  finalResult       Int
  companyComment   String
  recommendation   String?
  verifiedSkillIds String[]              @default([])
  createdAt        DateTime              @default(now())
  application      ExperienceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("experience_evaluations")
}

model VerifiedExperience {
  id             String                @id @default(uuid())
  applicationId  String                @unique
  candidateId    String
  title          String
  companyName    String
  summary        String
  startsAt       DateTime
  completedAt    DateTime
  durationWeeks  Int
  public         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  application    ExperienceApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidate      CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skills         VerifiedSkill[]
  certificate    ExperienceCertificate?

  @@index([candidateId, completedAt])
  @@map("verified_experiences")
}

model VerifiedSkill {
  verifiedExperienceId String
  skillId              String
  verifiedExperience   VerifiedExperience @relation(fields: [verifiedExperienceId], references: [id], onDelete: Cascade)
  skill                Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([verifiedExperienceId, skillId])
  @@index([skillId])
  @@map("verified_skills")
}

model ExperienceCertificate {
  id                   String                      @id @default(uuid())
  verifiedExperienceId String                      @unique
  code                 String                      @unique
  status               ExperienceCertificateStatus @default(ACTIVE)
  issuedAt             DateTime                    @default(now())
  revokedAt            DateTime?
  revokedById          String?
  verifiedExperience   VerifiedExperience          @relation(fields: [verifiedExperienceId], references: [id], onDelete: Restrict)

  @@index([status, issuedAt])
  @@map("experience_certificates")
}

model SkillEvidence {
  id                String           @id @default(uuid())
  candidateId       String
  skillId           String
  declaredScore     Int              @default(0)
  projectScore      Int              @default(0)
  verifiedScore     Int              @default(0)
  consistencyScore  Int              @default(0)
  totalScore        Int              @default(0)
  projectCount      Int              @default(0)
  verifiedCount     Int              @default(0)
  averageRating     Decimal?         @db.Decimal(3, 2)
  calculatedAt      DateTime         @default(now())
  candidate         CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill             Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId, totalScore])
  @@index([skillId, totalScore])
  @@map("skill_evidence")
}

model ProjectContribution {
  id                  String                       @id @default(uuid())
  projectId           String
  candidateId         String
  validatorName       String
  validatorEmail      String
  contributionRole    String
  contributionSummary String
  skillIds            String[]                     @default([])
  status              ContributionValidationStatus @default(PENDING)
  tokenHash           String                       @unique
  expiresAt           DateTime
  respondedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  project             Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidate           CandidateProfile             @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([projectId, status])
  @@index([validatorEmail, status])
  @@map("project_contributions")
}

model CompanyOpportunityIndex {
  id                    String         @id @default(uuid())
  companyId             String         @unique
  score                 Int
  responseRate          Int
  processCompletionRate Int
  feedbackRate          Int
  juniorFriendlyRate    Int
  selectionRate         Int
  sampleSize            Int
  calculatedAt          DateTime       @default(now())
  company               CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([score, sampleSize])
  @@map("company_opportunity_indexes")
}

model TalentPassport {
  id          String           @id @default(uuid())
  candidateId String           @unique
  publicCode  String           @unique
  active      Boolean          @default(true)
  issuedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([active, updatedAt])
  @@map("talent_passports")
}
